[Unit]
Description=Prima Assicurazioni scraper (Playwright + Xvfb/VNC) — telecomando HTTP su 127.0.0.1:4600
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/withus-backend/scraper/prima
ExecStart=/opt/withus-backend/scraper/prima/start-service.sh
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
Environment=DISPLAY=:94
Environment=VNC_PASS=prima2026
# IMPORTANTE: stessa FONTI_SECRET del backend per decifrare le credenziali del Pannello Fonti.
# Se withus-backend usa un EnvironmentFile, riusarlo qui:
# EnvironmentFile=/opt/withus-backend/.env

[Install]
WantedBy=multi-user.target
