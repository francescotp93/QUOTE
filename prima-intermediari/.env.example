# --- Credenziali portale Prima Intermediari -------------------------
PRIMA_EMAIL=agenziahditrapani@gmail.com
PRIMA_PASSWORD=

# --- Supabase (usa la SERVICE ROLE key, non la anon) -----------------
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Comportamento scraper ------------------------------------------
# limite per segmento (status x productType). Il server e' lento:
# alzarlo aumenta il rischio di timeout 502.
PRIMA_LIMIT=800
# timeout singola query GraphQL in ms (l'API impiega 45-60s su dataset grandi)
PRIMA_TIMEOUT_MS=180000
# pausa tra una query e l'altra, per non stressare il backend
PRIMA_DELAY_MS=2000
# 1 = headless durante il re-login automatico
PRIMA_HEADLESS=1
