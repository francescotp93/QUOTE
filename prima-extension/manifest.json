{
  "manifest_version": 3,
  "name": "With Us · Connettore",
  "version": "2.0.0",
  "description": "Quota Prima dal tuo browser e registra, quando lo chiedi tu, le chiamate dei portali compagnia (Italiana, HDI, Allianz, Prima, Groupama, AXA, Sara, 24H) per mandarle a IAM.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.prima.it/*",
    "https://*.plurima.net/*",
    "https://*.hdia.it/*",
    "https://*.hdi.it/*",
    "https://*.allianz.it/*",
    "https://*.groupama.it/*",
    "https://*.axa-italia.it/*",
    "https://*.axa.it/*",
    "https://*.sara.it/*",
    "https://*.24hassistance.com/*",
    "https://api.withusassicurazioni.it/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "With Us · Connettore"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.prima.it/*"
      ],
      "js": [
        "prezzo.js",
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.prima.it/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.plurima.net/*",
        "https://*.hdia.it/*",
        "https://*.hdi.it/*",
        "https://*.allianz.it/*",
        "https://*.prima.it/*",
        "https://*.groupama.it/*",
        "https://*.axa-italia.it/*",
        "https://*.axa.it/*",
        "https://*.sara.it/*",
        "https://*.24hassistance.com/*"
      ],
      "js": [
        "registratore.js",
        "cattura-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.plurima.net/*",
        "https://*.hdia.it/*",
        "https://*.hdi.it/*",
        "https://*.allianz.it/*",
        "https://*.prima.it/*",
        "https://*.groupama.it/*",
        "https://*.axa-italia.it/*",
        "https://*.axa.it/*",
        "https://*.sara.it/*",
        "https://*.24hassistance.com/*"
      ],
      "js": [
        "cattura-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.withusassicurazioni.it/*"
      ],
      "js": [
        "quoto-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
