# ── withus-backend — variabili d'ambiente ──────────────────────────────────────
# Su Render queste si impostano in "Environment". NON mettere password nel repo.

# Origini consentite (CORS). Default già OK per i tuoi domini.
CORS_ORIGINS=https://iam.withusassicurazioni.it,https://quoto.withusassicurazioni.it,https://www.withusassicurazioni.it

# ── FASE MAIL (da compilare al passo successivo) ───────────────────────────────
# Segreto JWT del progetto Supabase (Settings → API → JWT Secret): serve per
# verificare che le richieste arrivino da un utente loggato nelle app.
# SUPABASE_JWT_SECRET=

# Server di posta Aruba (valori standard Aruba)
# MAIL_IMAP_HOST=imaps.aruba.it
# MAIL_IMAP_PORT=993
# MAIL_SMTP_HOST=smtps.aruba.it
# MAIL_SMTP_PORT=465
# Le credenziali delle singole caselle si configureranno qui in modo sicuro.

# ── FASE PAGAMENTI (più avanti) ────────────────────────────────────────────────
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
# AXERVE_SHOP_LOGIN=
# AXERVE_API_KEY=
