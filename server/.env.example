# ── withus-backend — variabili d'ambiente ──────────────────────────────────────
# Su Render: Environment → Add Environment Variable. NON mettere password nel repo.

# Origini consentite (CORS). Default già OK per i tuoi domini.
CORS_ORIGINS=https://iam.withusassicurazioni.it,https://quoto.withusassicurazioni.it,https://www.withusassicurazioni.it

# ── MAIL ───────────────────────────────────────────────────────────────────────
# Segreto JWT del progetto Supabase (Settings → API → JWT Secret).
SUPABASE_JWT_SECRET=

# Casella da collegare per prima
MAIL_USER=amministrazione@withusassicurazioni.it
MAIL_PASS=

# Server Aruba (valori standard: di solito NON serve cambiarli)
MAIL_IMAP_HOST=imaps.aruba.it
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtps.aruba.it
MAIL_SMTP_PORT=465

# Solo queste email (loggate nelle app) possono usare la posta. Consigliato.
MAIL_ALLOWED_EMAILS=francesco.oddo199307@gmail.com

# Chiave per il test di connessione casella (apri /mail/selftest?key=...). Temporanea.
MAIL_SELFTEST_KEY=

# ── PAGAMENTI (più avanti) ─────────────────────────────────────────────────────
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
# AXERVE_SHOP_LOGIN=
# AXERVE_API_KEY=

# (opzionale) Openapi.it banca dati targa — se assente si usa lo scraper gratuito
OPENAPI_TARGA_TOKEN=
OPENAPI_TARGA_URL=https://targa.openapi.it
