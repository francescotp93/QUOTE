# ── Variabili d'ambiente withus-backend ──────────────────────────────────────────
# Copia questo file in ../.env e incolla i VALORI (gli stessi che hai su Render).
# NON committare il file .env con i valori reali.

# Porta (Caddy fa da HTTPS davanti)
PORT=3000

# Domini autorizzati (CORS) — aggiungi il nuovo dominio del backend se serve
CORS_ORIGINS=https://iam.withusassicurazioni.it,https://quoto.withusassicurazioni.it,https://www.withusassicurazioni.it

# Supabase (verifica login + permessi)
SUPABASE_URL=https://ekjxrnsfqxnfxzrthdcf.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Chiave pubblica (anon). Serve alle campagne per gruppo e per segmento: quelle
# letture viaggiano con il token di CHI CHIEDE, non con la chiave di servizio,
# cosi' la Row Level Security vale anche dal server. Senza questa variabile il
# codice ripiega sulla service role come apikey del gateway: funziona, ma e' un
# permesso piu' largo del necessario.
SUPABASE_ANON_KEY=

# Mail (Aruba)
MAIL_USER=
MAIL_PASS=
MAIL_USER_2=
MAIL_PASS_2=
MAIL_USER_3=
MAIL_PASS_3=
MAIL_ALLOWED_EMAILS=
MAIL_FROM_NAME=
MAIL_SELFTEST_KEY=
BREVO_API_KEY=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox

# Stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
