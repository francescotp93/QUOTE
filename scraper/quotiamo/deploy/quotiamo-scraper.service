[Unit]
Description=Withus - Scraper Quotiamo portale comparatore
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/quote/scraper/quotiamo
ExecStart=/usr/bin/env bash start-service.sh
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
EnvironmentFile=-/opt/quote/server/.env

[Install]
WantedBy=multi-user.target
